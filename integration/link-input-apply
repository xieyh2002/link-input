#!/bin/bash
set -eu
if [[ -z ${NIRI_SOCKET:-} ]] || ! niri msg version >/dev/null 2>&1; then
    printf '%s\n' '配置已保存，下次启动输入法时生效。当前未连接到 niri。' >&2
    exit 1
fi
exec 9>"${XDG_RUNTIME_DIR:?}/link-input-apply.lock"
flock -w 3 9 || { printf '%s\n' '另一次设置应用仍在进行。' >&2; exit 1; }
prefix=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
native="$prefix/bin/qingyin"
systemctl --user restart qingyin-ibus.service
while read -r pid; do
    case "$(readlink "/proc/$pid/exe" 2>/dev/null)" in
        "$native"|"$native (deleted)") ;;
        *) continue ;;
    esac
    kill -TERM "$pid" 2>/dev/null || continue
    for ((i=0; i<40; i++)); do
        if ! kill -0 "$pid" 2>/dev/null; then break; fi
        sleep .05
    done
done < <(pgrep -u "$UID" -x qingyin || true)
started_at=$(date '+%Y-%m-%d %H:%M:%S.%6N')
niri msg action spawn -- /usr/bin/systemd-cat -t qingyin-wayland "$native"
for ((i=0; i<200; i++)); do
    if [[ "$(ibus engine 2>/dev/null || true)" == qingyin ]] &&
       journalctl --user -t qingyin-wayland --since "$started_at" -o cat --no-pager |
           grep -F 'link输入法已连接 Wayland' >/dev/null; then
        printf '%s\n' '设置已应用。'
        exit 0
    fi
    sleep .15
done
printf '%s\n' '配置已保存，但输入法未确认重新连接。' >&2
exit 1
