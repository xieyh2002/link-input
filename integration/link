#!/bin/sh
if [ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && [ "$1" = "--settings" ]; }; then
    prefix=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 1
    exec /usr/bin/python3 "$prefix/libexec/link-input/link-settings.py"
fi
if [ "${0##*/}" = link-input ]; then
    printf '%s\n' '用法：link-input [--settings]' >&2
    exit 2
fi
exec /usr/bin/link "$@"
